# Токен бота от @BotFather (обязательно)
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Часовой пояс для напоминаний — укажите свой! (по умолчанию Europe/Moscow)
# Примеры: Europe/Moscow, Asia/Tashkent, Europe/Amsterdam
TIMEZONE=Europe/Moscow

# Путь к файлу базы данных SQLite (по умолчанию bot.db)
DB_PATH=bot.db
