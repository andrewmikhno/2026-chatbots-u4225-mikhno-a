# Токен бота от @BotFather (обязательно)
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Часовой пояс для напоминаний — укажите свой! (по умолчанию Europe/Moscow)
# Примеры: Europe/Moscow, Asia/Tashkent, Europe/Amsterdam
TIMEZONE=Europe/Moscow

# Путь к файлу базы данных SQLite (по умолчанию bot.db)
DB_PATH=bot.db

# --- Lab2: OpenAI (распознавание голосовых и разбор команд) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=gpt-4o-mini-transcribe

# --- Lab2: Google Calendar (сервисный аккаунт) ---
# JSON-ключ сервисного аккаунта
GOOGLE_CREDENTIALS_FILE=credentials.json
# ID календаря — для основного календаря это ваш gmail
GOOGLE_CALENDAR_ID=you@gmail.com

# --- Lab3 ---
# Владелец бота (Telegram user id): только ему доступны Google Calendar и /stats.
# Узнать свой id: написать боту @userinfobot
OWNER_ID=123456789
